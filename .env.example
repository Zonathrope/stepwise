# Copy to .env and fill in values

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://stepper:stepper@localhost:5432/stepper

# Agent server port (default: 4000)
PORT=4000

# Dashboard URL shown to the server for CORS
DASHBOARD_URL=http://localhost:3000

# Optional: protect dashboard API with a static bearer token
# STEPPER_DASHBOARD_TOKEN=your-secret-token

# Dashboard: agent server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Optional: same token as above for dashboard → server auth
# STEPPER_DASHBOARD_TOKEN=your-secret-token
